  },
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "start": "node dist/src/index.js",
    "start:dev": "tsx ./src/index.ts",
    "lint": "oxlint && oxfmt --ignore-path=.oxfmtignore --check",
    "lint-fix": "oxfmt --ignore-path=.oxfmtignore && oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "simple-git-hooks": {
    "pre-push": "make lint"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.0",
