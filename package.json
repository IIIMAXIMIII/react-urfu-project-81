    "oxlint": "^1.78.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "es-toolkit": "^1.51.0"
  }
